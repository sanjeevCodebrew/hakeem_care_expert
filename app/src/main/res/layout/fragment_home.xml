                                android:orientation="horizontal"
                                android:overScrollMode="never"
                                android:paddingStart="@dimen/dp_8"
                                android:paddingEnd="@dimen/dp_8"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvMoreArticles"
                                tools:listitem="@layout/rv_item_article" />

                            <include
                                android:id="@+id/clNoArticle"
                                layout="@layout/item_no_data"
                                android:layout_width="@dimen/dp_0"
                                android:visibility="gone"
                                android:layout_marginTop="@dimen/dp_16"
                                android:layout_height="wrap_content"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/rvArticle" />

                            <TextView
                                android:id="@+id/tvBlogs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_16"
                                android:layout_marginTop="@dimen/dp_24"
                                android:layout_marginEnd="@dimen/dp_16"
                                android:fontFamily="@font/campton_semibold"
                                android:text="@string/blogs"
                                android:textColor="@color/colorHomeTitle"
                                android:textSize="@dimen/sp_24"
                                android:visibility="gone"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/clNoArticle" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPostBlogs"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_36"
                                android:layout_marginStart="@dimen/dp_16"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:drawableStart="@drawable/ic_add_post"
                                android:drawablePadding="@dimen/dp_4"
                                android:focusable="true"
                                android:fontFamily="@font/campton_medium"
                                android:gravity="center_vertical"
                                android:padding="@dimen/dp_4"
                                android:text="@string/post"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/sp_14"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="@id/tvBlogs"
                                app:layout_constraintStart_toEndOf="@id/tvBlogs"
                                app:layout_constraintTop_toTopOf="@+id/tvBlogs" />


                            <TextView
                                android:id="@+id/tvMoreBlogs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/dp_16"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/campton_medium"
                                android:padding="@dimen/dp_4"
                                android:text="@string/view_all"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/sp_16"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="@+id/tvBlogs"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@+id/tvBlogs" />


                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvBlogs"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_8"
                                android:clipToPadding="false"
                                android:orientation="horizontal"
                                android:overScrollMode="never"
                                android:paddingStart="@dimen/dp_8"
                                android:paddingEnd="@dimen/dp_8"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvBlogs"
                                tools:listitem="@layout/rv_item_article" />

                            <include
                                android:id="@+id/clNoBlog"
                                layout="@layout/item_no_data"
                                android:layout_width="@dimen/dp_0"
                                android:visibility="gone"
                                android:layout_marginTop="@dimen/dp_16"
                                android:layout_height="wrap_content"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/rvBlogs" />


                            <TextView
                                android:id="@+id/tvHealthTools"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_16"
                                android:layout_marginTop="@dimen/dp_24"
                                android:layout_marginEnd="@dimen/dp_16"
                                android:fontFamily="@font/campton_medium"
                                android:text="@string/health_tools"
                                android:textColor="@color/colorHomeTitle"
                                android:textSize="@dimen/sp_24"
                                android:visibility="gone"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/clNoBlog" />


                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvHealthTools"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_8"
                                android:clipToPadding="false"
                                android:paddingStart="@dimen/dp_8"
                                android:paddingEnd="@dimen/dp_8"
                                android:visibility="gone"
                                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvHealthTools"
                                app:spanCount="2"
                                tools:itemCount="4"
                                tools:listitem="@layout/rv_item_health_tools" />


                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.core.widget.NestedScrollView>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


                <include
                    android:id="@+id/clNoData"
                    layout="@layout/item_no_data"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/toolbar" />


                <include
                    android:id="@+id/clLoader"
                    layout="@layout/item_loader"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_0"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/toolbar" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.navigation.NavigationView
                android:id="@+id/navView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/colorWhite"
                android:fitsSystemWindows="true"
                app:headerLayout="@layout/nav_header_home"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:menu="@menu/menu_home"
                app:theme="@style/NavigationViewStyle">

            </com.google.android.material.navigation.NavigationView>


        </androidx.drawerlayout.widget.DrawerLayout>
    </RelativeLayout>
</layout>




