<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/etDiagnosis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CODE"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvTitle"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCodeV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CODE"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintTop_toBottomOf="@id/tvCode"
            app:layout_constraintStart_toStartOf="@id/tvCode"
            app:layout_constraintEnd_toStartOf="@+id/tvTitle"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TITLE"
            android:maxLines="2"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/tvCode"
            app:layout_constraintBottom_toBottomOf="@id/tvCode"
            app:layout_constraintStart_toEndOf="@+id/tvCode"
            app:layout_constraintEnd_toStartOf="@id/tvAction"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CODE"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="@+id/tvTitle"/>



        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ACTION"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/tvCode"
            app:layout_constraintStart_toEndOf="@+id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="@dimen/dp_10"
            android:backgroundTint="@android:color/holo_red_dark"
            app:layout_constraintEnd_toEndOf="@id/tvAction"
            app:layout_constraintTop_toBottomOf="@id/tvAction"
            app:layout_constraintStart_toStartOf="@id/tvAction" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>