        <activity
            android:name=".ui.aghora.AghoraNewActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.calling.CallingActivity"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showOnLockScreen="true"
            android:exported="true"
            android:showWhenLocked="true" />

        <activity
            android:name=".ui.dashboard.location.AddAddressActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.webview.WebViewActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.dashboard.wallet.addmoney.AddMoneyActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <service
            android:name=".ui.calling.IncomingCallNotificationService"
            android:exported="false"
            android:enabled="true" />


        <!-- Facebook implementation -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- Add your API key here -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_places_api_key" />

